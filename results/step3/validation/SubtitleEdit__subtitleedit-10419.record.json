  "log_parser": "def parser(log: str) -> dict[str, str]:\n    import re\n    import xml.etree.ElementTree as ET\n\n    results: dict[str, str] = {}\n    priority = {\"pass\": 0, \"skip\": 1, \"fail\": 2}\n\n    def record(name: str, status: str) -> None:\n        if not name or status not in priority:\n            return\n        prev = results.get(name)\n        if prev is None or priority[status] > priority[prev]:\n            results[name] = status\n\n    def normalize_status(raw: str) -> str:\n        raw = (raw or \"\").strip().lower()\n        if raw in {\"passed\", \"pass\", \"ok\", \"success\"}:\n            return \"pass\"\n        if raw in {\"skipped\", \"skip\", \"notexecuted\", \"notrun\", \"ignored\", \"inconclusive\", \"pending\", \"xfailed\", \"xfail\"}:\n            return \"skip\"\n        if raw in {\"failed\", \"fail\", \"error\", \"timeout\", \"aborted\", \"cancelled\", \"canceled\"}:\n            return \"fail\"\n        return \"fail\"\n\n    def parse_trx(root: ET.Element) -> None:\n        ns = \"\"\n        if root.tag.startswith(\"{\"):\n            ns = root.tag.split(\"}\")[0].strip(\"{\")\n\n        def q(tag: str) -> str:\n            return f\"{{{ns}}}{tag}\" if ns else tag\n\n        for unit in root.findall(\".//\" + q(\"UnitTestResult\")):\n            name = unit.attrib.get(\"testName\") or unit.attrib.get(\"name\")\n            outcome = unit.attrib.get(\"outcome\") or unit.attrib.get(\"result\")\n            status = normalize_status(outcome)\n            record(name, status)\n\n    def parse_junit(root: ET.Element) -> None:\n        for case in root.findall(\".//testcase\"):\n            name = case.attrib.get(\"name\") or \"\"\n            classname = case.attrib.get(\"classname\") or \"\"\n            full_name = f\"{classname}.{name}\".strip(\".\") if classname else name\n            status = \"pass\"\n            if case.find(\"failure\") is not None or case.find(\"error\") is not None:\n                status = \"fail\"\n            elif case.find(\"skipped\") is not None:\n                status = \"skip\"\n            record(full_name, status)\n\n    def parse_xml(doc: str) -> None:\n        doc = doc.strip()\n        if not doc:\n            return\n        try:\n            root = ET.fromstring(doc)\n        except ET.ParseError:\n            return\n        tag = root.tag.lower()\n        if tag.endswith(\"testrun\"):\n            parse_trx(root)\n        if root.find(\".//testcase\") is not None or tag.endswith(\"testsuite\") or tag.endswith(\"testsuites\"):\n            parse_junit(root)\n\n    def extract_xml_blocks(text: str) -> list[str]:\n        blocks: list[str] = []\n        for pattern in [\n            r\"<TestRun\\b.*?</TestRun>\",\n            r\"<testsuites\\b.*?</testsuites>\",\n            r\"<testsuite\\b.*?</testsuite>\",\n        ]:\n            blocks.extend(re.findall(pattern, text, flags=re.DOTALL))\n        if not blocks and \"<?xml\" in text:\n            parts = re.split(r\"(?=<\\?xml)\", text)\n            blocks.extend([p for p in parts if p.strip()])\n        if not blocks and \"<\" in text and \">\" in text:\n            blocks.append(text)\n        return blocks\n\n    for block in extract_xml_blocks(log):\n        parse_xml(block)\n\n    # Fallback text parsing for common frameworks\n    pytest_re = re.compile(r\"^(\\S+::\\S+)\\s+(PASSED|FAILED|SKIPPED|XFAIL|XPASS|ERROR)\\b\", re.MULTILINE)\n    for name, status in pytest_re.findall(log):\n        record(name, normalize_status(status))\n\n    unittest_re = re.compile(r\"^([\\w\\.]+)\\s+\\.\\.\\.\\s+(ok|FAIL|ERROR|skipped)\", re.MULTILINE | re.IGNORECASE)\n    for name, status in unittest_re.findall(log):\n        record(name, normalize_status(status))\n\n    go_re = re.compile(r\"^---\\s+(PASS|FAIL|SKIP):\\s+(\\S+)\", re.MULTILINE)\n    for status, name in go_re.findall(log):\n        record(name, normalize_status(status))\n\n    jest_re = re.compile(r\"^\\s*([\u2713\u2715\u25cb])\\s+(.+)$\", re.MULTILINE)\n    for symbol, name in jest_re.findall(log):\n        status = \"pass\" if symbol == \"\u2713\" else \"fail\" if symbol == \"\u2715\" else \"skip\"\n        record(name.strip(), status)\n\n    return results",
