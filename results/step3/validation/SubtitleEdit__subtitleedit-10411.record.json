  "log_parser": "def parser(log: str) -> dict[str, str]:\n    import re\n    import xml.etree.ElementTree as ET\n\n    results: dict[str, str] = {}\n\n    def strip_ns(tag: str) -> str:\n        return tag.rsplit(\"}\", 1)[-1] if tag else tag\n\n    def normalize_outcome(outcome: str | None) -> str:\n        if not outcome:\n            return \"fail\"\n        o = outcome.strip().lower()\n        if o in (\"passed\", \"pass\", \"success\", \"succeeded\"):\n            return \"pass\"\n        if o in (\"skipped\", \"notexecuted\", \"ignored\", \"inconclusive\", \"skip\"):\n            return \"skip\"\n        if o in (\"failed\", \"fail\", \"error\", \"timeout\", \"aborted\", \"canceled\", \"cancelled\", \"crashed\"):\n            return \"fail\"\n        return \"fail\"\n\n    def set_status(name: str | None, status: str) -> None:\n        if not name:\n            return\n        priority = {\"pass\": 0, \"skip\": 1, \"fail\": 2}\n        prev = results.get(name)\n        if prev is None or priority[status] > priority[prev]:\n            results[name] = status\n\n    text = log.lstrip(\"\\ufeff\")\n\n    # Parse MSTest/TRX blocks\n    for match in re.finditer(r\"<TestRun\\b.*?</TestRun>\", text, re.DOTALL | re.IGNORECASE):\n        block = match.group(0)\n        try:\n            root = ET.fromstring(block)\n        except ET.ParseError:\n            continue\n\n        testid_to_name: dict[str, str] = {}\n        execid_to_testid: dict[str, str] = {}\n\n        for node in root.iter():\n            if strip_ns(node.tag) == \"UnitTest\":\n                name = node.attrib.get(\"name\") or node.attrib.get(\"testName\")\n                test_id = node.attrib.get(\"id\") or node.attrib.get(\"testId\")\n                if name and test_id:\n                    testid_to_name[test_id] = name\n                for child in node:\n                    if strip_ns(child.tag) == \"Execution\":\n                        exec_id = child.attrib.get(\"id\")\n                        if exec_id and test_id:\n                            execid_to_testid[exec_id] = test_id\n\n        for node in root.iter():\n            if strip_ns(node.tag) == \"UnitTestResult\":\n                name = node.attrib.get(\"testName\")\n                if not name:\n                    test_id = node.attrib.get(\"testId\")\n                    exec_id = node.attrib.get(\"executionId\")\n                    if not test_id and exec_id:\n                        test_id = execid_to_testid.get(exec_id)\n                    if test_id:\n                        name = testid_to_name.get(test_id)\n                outcome = node.attrib.get(\"outcome\")\n                set_status(name, normalize_outcome(outcome))\n\n    # Fallback regex for UnitTestResult attributes anywhere\n    for match in re.finditer(r\"<UnitTestResult\\b([^>]+?)>\", text, re.IGNORECASE):\n        attrs = match.group(1)\n        name_match = re.search(r'\\btestName=\"([^\"]+)\"', attrs, re.IGNORECASE)\n        outcome_match = re.search(r'\\boutcome=\"([^\"]+)\"', attrs, re.IGNORECASE)\n        if name_match and outcome_match:\n            set_status(name_match.group(1), normalize_outcome(outcome_match.group(1)))\n\n    # Parse JUnit/TestNG-like XML blocks\n    for match in re.finditer(r\"<testsuite\\b.*?</testsuite>\", text, re.DOTALL | re.IGNORECASE):\n        block = match.group(0)\n        try:\n            root = ET.fromstring(block)\n        except ET.ParseError:\n            continue\n        for tc in root.iter():\n            if strip_ns(tc.tag) == \"testcase\":\n                name = tc.attrib.get(\"name\")\n                classname = tc.attrib.get(\"classname\")\n                fullname = f\"{classname}.{name}\" if classname and name else (classname or name)\n                status = \"pass\"\n                for child in tc:\n                    tag = strip_ns(child.tag)\n                    if tag in (\"failure\", \"error\"):\n                        status = \"fail\"\n                        break\n                    if tag == \"skipped\":\n                        status = \"skip\"\n                set_status(fullname, status)\n\n    # Line-based patterns (pytest, unittest, go test, jest)\n    for line in text.splitlines():\n        line = line.strip()\n        if not line:\n            continue\n\n        m = re.match(r\"(.+?)::([^\\s]+)\\s+(PASSED|FAILED|SKIPPED|ERROR|XFAIL|XPASS)\", line)\n        if m:\n            outcome = m.group(3).lower()\n            status = \"pass\" if outcome in (\"passed\", \"xpass\") else (\"skip\" if outcome in (\"skipped\", \"xfail\") else \"fail\")\n            set_status(f\"{m.group(1)}::{m.group(2)}\", status)\n            continue\n\n        m = re.match(r\"([A-Za-z0-9_.]+)\\s+\\.\\.\\.\\s+(ok|OK|FAIL|ERROR|SKIP|SKIPPED)\", line)\n        if m:\n            outcome = m.group(2).lower()\n            status = \"pass\" if outcome == \"ok\" else (\"skip\" if outcome.startswith(\"skip\") else \"fail\")\n            set_status(m.group(1), status)\n            continue\n\n        m = re.match(r\"---\\s+(PASS|FAIL|SKIP):\\s+([^\\s]+)\", line)\n        if m:\n            outcome = m.group(1).lower()\n            status = \"pass\" if outcome == \"pass\" else (\"skip\" if outcome == \"skip\" else \"fail\")\n            set_status(m.group(2), status)\n            continue\n\n        m = re.match(r\"^(PASS|FAIL)\\s+(.+)$\", line)\n        if m:\n            status = \"pass\" if m.group(1) == \"PASS\" else \"fail\"\n            set_status(m.group(2).strip(), status)\n            continue\n\n    return results",
