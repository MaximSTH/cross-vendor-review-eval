  "patch": "diff --git a/src/libse/SubtitleFormats/TimedTextImsc11.cs b/src/libse/SubtitleFormats/TimedTextImsc11.cs\nindex 3fde25ff766..29547afa30e 100644\n--- a/src/libse/SubtitleFormats/TimedTextImsc11.cs\n+++ b/src/libse/SubtitleFormats/TimedTextImsc11.cs\n@@ -476,7 +476,7 @@ public override void LoadSubtitle(Subtitle subtitle, List<string> lines, string\n                     assStyle = GetAssStyleFromRegion(region.InnerText, xml);\n                 }\n \n-                var text = assStyle + ReadParagraph(node, xml);\n+                var text = assStyle + ReadParagraph(node, xml).TrimEnd();\n                 var p = new Paragraph(begin, end, text);\n                 subtitle.Paragraphs.Add(p);\n             }\n@@ -662,7 +662,7 @@ private static string ReadParagraph(XmlNode node, XmlDocument xml)\n                 }\n             }\n \n-            return pText.ToString().TrimEnd();\n+            return pText.ToString();\n         }\n \n         public static string RemoveTags(string text)\n",
  "test_patch": "diff --git a/tests/libse/SubtitleFormats/TimedTextImsc11Test.cs b/tests/libse/SubtitleFormats/TimedTextImsc11Test.cs\nnew file mode 100644\nindex 00000000000..736756a0184\n--- /dev/null\n+++ b/tests/libse/SubtitleFormats/TimedTextImsc11Test.cs\n@@ -0,0 +1,49 @@\n+\ufeffusing Nikse.SubtitleEdit.Core.Common;\n+using Nikse.SubtitleEdit.Core.SubtitleFormats;\n+\n+namespace LibSETests.SubtitleFormats;\n+\n+public class TimedTextImsc11Test\n+{\n+    [Fact]\n+    public void Italic_Trailing_Space_Preserved()\n+    {\n+        var sut = new TimedTextImsc11();\n+\n+        var xml = \"<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?>\" +\n+                  \"<tt xmlns=\\\"http://www.w3.org/ns/ttml\\\" xmlns:tts=\\\"http://www.w3.org/ns/ttml#styling\\\" xmlns:ttp=\\\"http://www.w3.org/ns/ttml#parameter\\\" ttp:profile=\\\"http://www.w3.org/ns/ttml/profile/imsc1/text\\\" ttp:timeBase=\\\"media\\\" xml:lang=\\\"en\\\">\" +\n+                  \"<head><styling>\" +\n+                  \"<style xml:id=\\\"italic\\\" tts:fontStyle=\\\"italic\\\"/>\" +\n+                  \"</styling></head>\" +\n+                  \"<body><div>\" +\n+                  \"<p begin=\\\"00:00:01.000\\\" end=\\\"00:00:03.000\\\"><span style=\\\"italic\\\">word </span><span>next</span></p>\" +\n+                  \"</div></body></tt>\";\n+\n+        var subtitle = new Subtitle();\n+        sut.LoadSubtitle(subtitle, xml.SplitToLines(), \"test.xml\");\n+\n+        Assert.Single(subtitle.Paragraphs);\n+        Assert.Equal(\"<i>word </i>next\", subtitle.Paragraphs[0].Text);\n+    }\n+\n+    [Fact]\n+    public void Italic_Leading_Space_Preserved()\n+    {\n+        var sut = new TimedTextImsc11();\n+\n+        var xml = \"<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?>\" +\n+                  \"<tt xmlns=\\\"http://www.w3.org/ns/ttml\\\" xmlns:tts=\\\"http://www.w3.org/ns/ttml#styling\\\" xmlns:ttp=\\\"http://www.w3.org/ns/ttml#parameter\\\" ttp:profile=\\\"http://www.w3.org/ns/ttml/profile/imsc1/text\\\" ttp:timeBase=\\\"media\\\" xml:lang=\\\"en\\\">\" +\n+                  \"<head><styling>\" +\n+                  \"<style xml:id=\\\"italic\\\" tts:fontStyle=\\\"italic\\\"/>\" +\n+                  \"</styling></head>\" +\n+                  \"<body><div>\" +\n+                  \"<p begin=\\\"00:00:01.000\\\" end=\\\"00:00:03.000\\\"><span>word</span><span style=\\\"italic\\\"> next</span></p>\" +\n+                  \"</div></body></tt>\";\n+\n+        var subtitle = new Subtitle();\n+        sut.LoadSubtitle(subtitle, xml.SplitToLines(), \"test.xml\");\n+\n+        Assert.Single(subtitle.Paragraphs);\n+        Assert.Equal(\"word<i> next</i>\", subtitle.Paragraphs[0].Text);\n+    }\n+}\n",
  "problem_statement": "Timed Text IMSC 1.1 subs - Spaces inside italic spans\nThere seems to be an issue on dealing with spaces inside italic spans in subs using the format Timed Text IMSC 1.1.\n\nI send you 2 files in attachment where the behaviour is different, one is correct and the other one is not.\n\nIn the file \"italics_space_before.xml\", there is a space inside the italic span before the word on lines 26 and 451 and it keeps the space correctly when converting to srt.\n\nIn the file \"italics_space_after.xml\", there is a space inside the italic span after the word on lines 31, 50 and 170 and it does not keep the space so the words are incorrectly joined.\n\n[italics_space_after.xml](https://github.com/user-attachments/files/26225587/italics_space_after.xml)\n[italics_space_before.xml](https://github.com/user-attachments/files/26225586/italics_space_before.xml)\n",
  "hints_text": "\n\n",
