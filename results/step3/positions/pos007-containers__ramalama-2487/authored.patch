+def test_load_cdi_config_merges_all_files_and_directories(tmp_path):
+    run_dir = tmp_path / "run"
+    etc_dir = tmp_path / "etc"
+    run_dir.mkdir()
+    etc_dir.mkdir()
+    (run_dir / "k8s.json").write_text('{"devices": [{"name": "GPU-123"}]}')
+    (run_dir / "management.yaml").write_text("devices:\n- name: managed\n")
+    (etc_dir / "nvidia.yml").write_text("devices:\n- name: all\n")
+
+    cdi = load_cdi_config([str(run_dir), str(etc_dir)])
+
+    assert cdi is not None
+    assert [device["name"] for device in cdi["devices"]] == ["GPU-123", "managed", "all"]
+
+
+def test_load_cdi_config_keeps_first_duplicate_in_deterministic_order(tmp_path):
+    first_dir = tmp_path / "first"
+    second_dir = tmp_path / "second"
+    first_dir.mkdir()
+    second_dir.mkdir()
+    (first_dir / "z-last.yaml").write_text("devices:\n- name: duplicate\n  source: z-last\n")
+    (first_dir / "a-first.yaml").write_text("devices:\n- name: duplicate\n  source: a-first\n")
+    (second_dir / "a-other.yaml").write_text("devices:\n- name: duplicate\n  source: second-directory\n")
+
+    cdi = load_cdi_config([str(first_dir), str(second_dir)])
+
+    assert cdi is not None
+    assert cdi["devices"] == [{"name": "duplicate", "source": "a-first"}]
+
