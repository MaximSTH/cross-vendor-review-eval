+@pytest.mark.parametrize(
+    ("opt_params", "args", "expected"),
+    [
+        # A negative flag: not passing it keeps the True default, passing it
+        # produces the False flag_value.
+        ({"flag_value": False, "default": True}, [], True),
+        ({"flag_value": False, "default": True}, ["--without-xyz"], False),
+        # Explicitly marking it as a flag makes no difference.
+        ({"flag_value": False, "default": True, "is_flag": True}, [], True),
+        (
+            {"flag_value": False, "default": True, "is_flag": True},
+            ["--without-xyz"],
+            False,
+        ),
+        # A default which is not True is used as-is, as before.
+        ({"flag_value": False, "default": False}, [], False),
+        ({"flag_value": False, "default": False}, ["--without-xyz"], False),
+        ({"flag_value": False, "default": None}, [], None),
+        ({"flag_value": False, "default": None}, ["--without-xyz"], False),
+    ],
+)
+def test_negative_boolean_flag(runner, opt_params, args, expected):
+    """``default=True`` is not re-interpreted as ``flag_value`` for boolean flags.
+
+    Doing so would make a negative flag like ``--without-xyz`` collapse its default
+    to ``False``, and thus be impossible to express.
+    """
+
+    @click.command()
+    @click.option("--without-xyz", "enable_xyz", **opt_params)
+    def cmd(enable_xyz):
+        click.echo(repr(enable_xyz), nl=False)
+
+    result = runner.invoke(cmd, args)
+    assert result.exit_code == 0
+    assert result.output == repr(expected)
+
+
+def test_negative_boolean_flag_show_default(runner):
+    """A negative flag advertises its own default, not its ``flag_value``."""
+    opt = click.Option(
+        ["--without-xyz", "enable_xyz"],
+        flag_value=False,
+        default=True,
+        show_default=True,
+    )
+    ctx = click.Context(click.Command("test"))
+    assert opt.get_default(ctx) is True
+    assert opt.get_help_extra(ctx) == {"default": "True"}
+
+
