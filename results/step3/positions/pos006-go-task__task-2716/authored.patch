+
+func writeFile(t *testing.T, path string) {
+	t.Helper()
+	require.NoError(t, os.MkdirAll(filepath.Dir(path), 0o755))
+	require.NoError(t, os.WriteFile(path, []byte("content"), 0o644))
+}
+
+func TestTimestampCheckerGeneratesRemoved(t *testing.T) {
+	t.Parallel()
+
+	dir := t.TempDir()
+	writeFile(t, filepath.Join(dir, "src.txt"))
+
+	task := &ast.Task{
+		Task:      "build",
+		Dir:       dir,
+		Sources:   []*ast.Glob{{Glob: "src.txt"}},
+		Generates: []*ast.Glob{{Glob: "out.txt"}},
+	}
+
+	checker := NewTimestampChecker(filepath.Join(dir, ".task"), false)
+
+	// The generated file was never produced, so the task is not up-to-date.
+	upToDate, err := checker.IsUpToDate(task)
+	require.NoError(t, err)
+	assert.False(t, upToDate)
+
+	// Simulate the task running and producing its generated file.
+	writeFile(t, filepath.Join(dir, "out.txt"))
+
+	upToDate, err = checker.IsUpToDate(task)
+	require.NoError(t, err)
+	assert.True(t, upToDate)
+
+	// The generated file is removed (e.g. by a clean task). Even though the
+	// sources are untouched and older than the last execution, the task must
+	// run again.
+	require.NoError(t, os.Remove(filepath.Join(dir, "out.txt")))
+
+	upToDate, err = checker.IsUpToDate(task)
+	require.NoError(t, err)
+	assert.False(t, upToDate)
+
+	// Once the file is generated again, the task is up-to-date once more.
+	writeFile(t, filepath.Join(dir, "out.txt"))
+
+	upToDate, err = checker.IsUpToDate(task)
+	require.NoError(t, err)
+	assert.True(t, upToDate)
+}
+
+func TestTimestampCheckerGeneratesGlobRemoved(t *testing.T) {
+	t.Parallel()
+
+	dir := t.TempDir()
+	writeFile(t, filepath.Join(dir, "src.txt"))
+
+	task := &ast.Task{
+		Task:      "build",
+		Dir:       dir,
+		Sources:   []*ast.Glob{{Glob: "src.txt"}},
+		Generates: []*ast.Glob{{Glob: "dist/*.txt"}},
+	}
+
+	checker := NewTimestampChecker(filepath.Join(dir, ".task"), false)
+
+	upToDate, err := checker.IsUpToDate(task)
+	require.NoError(t, err)
+	assert.False(t, upToDate)
+
+	writeFile(t, filepath.Join(dir, "dist", "out.txt"))
+
+	upToDate, err = checker.IsUpToDate(task)
+	require.NoError(t, err)
+	assert.True(t, upToDate)
+
+	// A wildcard that no longer matches anything means the task must run.
+	require.NoError(t, os.RemoveAll(filepath.Join(dir, "dist")))
+
+	upToDate, err = checker.IsUpToDate(task)
+	require.NoError(t, err)
+	assert.False(t, upToDate)
+}
+
+func TestTimestampCheckerWithoutGenerates(t *testing.T) {
+	t.Parallel()
+
+	dir := t.TempDir()
+	writeFile(t, filepath.Join(dir, "src.txt"))
+
+	task := &ast.Task{
+		Task:    "build",
+		Dir:     dir,
+		Sources: []*ast.Glob{{Glob: "src.txt"}},
+	}
+
+	checker := NewTimestampChecker(filepath.Join(dir, ".task"), false)
+
+	// A task without 'generates' relies solely on the internal timestamp file,
+	// which must keep working as before.
+	upToDate, err := checker.IsUpToDate(task)
+	require.NoError(t, err)
+	assert.False(t, upToDate)
+
+	upToDate, err = checker.IsUpToDate(task)
+	require.NoError(t, err)
+	assert.True(t, upToDate)
+}
+
+func TestTimestampCheckerNegatedGeneratesAreIgnored(t *testing.T) {
+	t.Parallel()
+
+	dir := t.TempDir()
+	writeFile(t, filepath.Join(dir, "src.txt"))
+
+	task := &ast.Task{
+		Task:    "build",
+		Dir:     dir,
+		Sources: []*ast.Glob{{Glob: "src.txt"}},
+		Generates: []*ast.Glob{
+			{Glob: "out.txt"},
+			{Glob: "excluded.txt", Negate: true},
+		},
+	}
+
+	checker := NewTimestampChecker(filepath.Join(dir, ".task"), false)
+
+	upToDate, err := checker.IsUpToDate(task)
+	require.NoError(t, err)
+	assert.False(t, upToDate)
+
+	writeFile(t, filepath.Join(dir, "out.txt"))
+
+	// The excluded entry never exists, but it must not force the task to run.
+	upToDate, err = checker.IsUpToDate(task)
+	require.NoError(t, err)
+	assert.True(t, upToDate)
+}
