+// TestStatusTimestampGeneratesRemoved ensures that a task using the timestamp
+// method runs again when its generated files were removed, even though its
+// sources are older than the last execution.
+func TestStatusTimestampGeneratesRemoved(t *testing.T) { // nolint:paralleltest // cannot run in parallel
+	const dir = "testdata/timestamp"
+
+	tests := []struct {
+		task      string
+		generated string
+	}{
+		{"build", "generated.txt"},
+		{"build-wildcard", "dist/generated.txt"},
+	}
+
+	for _, test := range tests { // nolint:paralleltest // cannot run in parallel
+		t.Run(test.task, func(t *testing.T) {
+			generated := filepathext.SmartJoin(dir, test.generated)
+			_ = os.RemoveAll(filepathext.SmartJoin(dir, ".task"))
+			_ = os.RemoveAll(filepathext.SmartJoin(dir, "dist"))
+			_ = os.Remove(generated)
+
+			var buff bytes.Buffer
+			e := task.NewExecutor(
+				task.WithDir(dir),
+				task.WithStdout(&buff),
+				task.WithStderr(&buff),
+				task.WithTempDir(task.TempDir{
+					Remote:      filepathext.SmartJoin(dir, ".task"),
+					Fingerprint: filepathext.SmartJoin(dir, ".task"),
+				}),
+			)
+			require.NoError(t, e.Setup())
+
+			upToDate := `task: Task "` + test.task + `" is up to date` + "\n"
+
+			// First run generates the file.
+			require.NoError(t, e.Run(t.Context(), &task.Call{Task: test.task}))
+			require.FileExists(t, generated)
+			assert.NotEqual(t, upToDate, buff.String())
+
+			// Second run does nothing, since nothing changed.
+			buff.Reset()
+			require.NoError(t, e.Run(t.Context(), &task.Call{Task: test.task}))
+			assert.Equal(t, upToDate, buff.String())
+
+			// Removing the generated file (as a clean task would) must make the
+			// task run again and recreate it.
+			require.NoError(t, os.Remove(generated))
+
+			buff.Reset()
+			require.NoError(t, e.Run(t.Context(), &task.Call{Task: test.task}))
+			assert.NotEqual(t, upToDate, buff.String())
+			require.FileExists(t, generated)
+
+			// And it is considered up to date again afterwards.
+			buff.Reset()
+			require.NoError(t, e.Run(t.Context(), &task.Call{Task: test.task}))
+			assert.Equal(t, upToDate, buff.String())
+		})
+	}
+}
