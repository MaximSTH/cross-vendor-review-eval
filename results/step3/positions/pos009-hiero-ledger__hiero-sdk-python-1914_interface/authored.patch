+            decline_staking_reward=True,
+        )
+
+    assert len(warnings) == 2
+    assert account_info.staking_info == StakingInfo(
+        decline_reward=True,
+        stake_period_start=Timestamp(100, 200),
+        pending_reward=Hbar.from_tinybars(1234),
