+def test_legacy_constructor_arguments_update_staking_info():
+    """Deprecated constructor arguments update the canonical staking object."""
+    staking_info = StakingInfo(
+        stake_period_start=Timestamp(100, 200),
+        pending_reward=Hbar.from_tinybars(1234),
+        staked_to_me=Hbar.from_tinybars(5678),
+        staked_node_id=3,
+    )
+
+    with pytest.warns(DeprecationWarning) as warnings:
+        account_info = AccountInfo(
+            staking_info=staking_info,
